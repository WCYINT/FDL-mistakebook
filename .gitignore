# === 用户个人配置（含本机绝对路径 / 凭据）===
# 注意：.gitignore 不支持行内注释！下面每条规则必须独占一行，
# 否则整行会被当成文件名模式、规则静默失效（历史事故：secrets.yaml 因此未被忽略）。
config/fdl_paths.yaml
config/secrets.yaml
config/secrets.yml
config/*.local.yaml
config/*.local.yml
.env
.env.local
.env.*.local
*.local.yml
*.local.yaml

# === 字体 vendor（macOS 系统字体，含版权，不随仓库分发）===
# Fonts are supplied by the host OS; restore locally per assets/fonts/README.md
assets/fonts/*.ttc
assets/fonts/*.ttf
assets/fonts/*.otf

# === ASR 模型（体积大，本地化部署）===
models/

